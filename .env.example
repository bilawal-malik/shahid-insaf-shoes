# ============================================================
# SIS — Shahid Insaf Shoes | Environment variables
# Copy this file to the locations noted below and fill values.
# NEVER commit real .env files.
# ============================================================

# ---------- apps/api/.env  (Express server) ----------
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/sis_dev
JWT_SECRET=generate-a-long-random-string-here
JWT_EXPIRES_IN=7d
WEB_ORIGIN=http://localhost:3100
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email (reset codes, order + contact notifications).
# BREVO_API_KEY works standalone (Brevo REST transport); SMTP_* takes
# precedence if SMTP_HOST is set. Without either, mail is skipped and
# recorded in the non-prod dev outbox (GET /admin/mail/outbox).
BREVO_API_KEY=
MAIL_FROM="SIS Shoes <your-verified-sender@example.com>"
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------- apps/web/.env.local  (Next.js) ----------
API_URL=http://localhost:4100/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_SITE_NAME=SIS - Shahid Insaf Shoes
